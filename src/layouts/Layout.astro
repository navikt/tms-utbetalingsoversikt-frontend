---
import { renderNaisMetaTags } from "@nais/apm";
import { fetchDecoratorHtml } from "@navikt/nav-dekoratoren-moduler/ssr";
import { getDecoratorEnvironment } from "../utils/server/environment";
import styles from "./Layout.module.css";
import "./index.css";

interface Props {
  title?: string;
}

const { title = "Mine utbetalinger - nav.no" } = Astro.props;

// Use the decorator's HTML output (not the React components): @astrojs/react 6
// drops <link rel="stylesheet"> / rel="preload" emitted by server-rendered
// React components, which left the decorator unstyled. set:html injects the
// markup verbatim. Matches the team pattern (tms-min-side, tms-utkast-frontend).
const Decorator = await fetchDecoratorHtml({
  env: getDecoratorEnvironment(),
  params: {
    context: "privatperson",
  },
});

const {
  DECORATOR_HEAD_ASSETS,
  DECORATOR_HEADER,
  DECORATOR_FOOTER,
  DECORATOR_SCRIPTS,
} = Decorator;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Fragment set:html={renderNaisMetaTags()} />
    <title>{title}</title>
    <link
      rel="preload"
      href="https://cdn.nav.no/aksel/@navikt/ds-css/8.10.1/index.min.css"
      as="style"
    />
    <link
      rel="stylesheet"
      href="https://cdn.nav.no/aksel/@navikt/ds-css/8.10.1/index.min.css"
    />
    <Fragment set:html={DECORATOR_HEAD_ASSETS} />
  </head>
  <body class="page-wrapper">
    <a class={styles.skipLink} href="#main-content">Hopp til hovedinnhold</a>
    <Fragment set:html={DECORATOR_HEADER} />
    <div class={styles.pageWrapper}>
      <main id="main-content" tabindex="-1" class={styles.pageContainer}>
        <slot />
      </main>
    </div>
    <Fragment set:html={DECORATOR_FOOTER} />
    <Fragment set:html={DECORATOR_SCRIPTS} />
  </body>
</html>
