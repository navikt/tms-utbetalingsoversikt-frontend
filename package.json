{
  "name": "tms-utbetalingsoversikt-frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "test": "NODE_ENV=development vitest run",
    "test:watch": "NODE_ENV=development vitest",
    "test:coverage": "NODE_ENV=development vitest run --coverage",
    "test:e2e": "playwright test",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/node": "11.0.0",
    "@astrojs/react": "6.0.0",
    "@grafana/faro-web-sdk": "1.19.0",
    "@nanostores/react": "1.1.0",
    "@navikt/aksel-icons": "8.10.1",
    "@navikt/astro-auth": "1.0.8",
    "@navikt/astro-logger": "1.0.0",
    "@navikt/ds-react": "8.10.1",
    "@navikt/nav-dekoratoren-moduler": "3.4.0",
    "@navikt/oasis": "4.1.4",
    "astro": "7.1.6",
    "dayjs": "1.11.21",
    "husky": "9.1.7",
    "jose": "6.2.3",
    "nanostores": "1.3.0",
    "prom-client": "15.1.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "swr": "2.4.2",
    "vitest": "4.1.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.1",
    "@navikt/astro-mocks": "0.1.5",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.5.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "29.1.1",
    "lint-staged": "16.1.6",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{astro,js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
